{
  "name": "naturalwrite",
  "productName": "NaturalWrite",
  "version": "0.1.0",
  "private": true,
  "description": "A personal writing studio that keeps your voice",
  "author": "NaturalWrite",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "node scripts/package.mjs",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@thednp/dommatrix": "^3.1.2",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.14.0"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.1",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  }
}
